# S.Thirukumaran Full Stack Portfolio Environment Variables

# Server Port
PORT=5000

# MySQL Database Configuration
# (Can be a local MySQL instance or cloud service like PlanetScale, Aiven, Railway, or Clever Cloud)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=portfolio_db

# MongoDB Database Configuration
# (Can be a local MongoDB instance or cloud service like MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/portfolio_db

# Note:
# If database credentials are left empty or unconfigured, the application runs seamlessly in
# high-fidelity resilient mode, saving contacts to portfolio_contacts.xlsx and serving rich portfolio data.
